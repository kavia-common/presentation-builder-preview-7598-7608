{
  "version": "1.0",
  "title": "Wizard Flow Schema (Template-driven)",
  "description": "Defines slide types used by the wizard: global_first, sf1..sf4, global_last. Field sets + placeholder IDs are intentionally minimal and meant to be extended by the user later.",
  "slideTypes": {
    "global_first": {
      "label": "Global First",
      "layoutId": "global_first",
      "fields": [
        {
          "id": "title",
          "label": "Deck Title",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": true, "maxLength": 120 },
          "mapping": { "placeholderId": "GF_TITLE" }
        },
        {
          "id": "subtitle",
          "label": "Subtitle",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": false, "maxLength": 160 },
          "mapping": { "placeholderId": "GF_SUBTITLE" }
        }
      ]
    },
    "sf1": {
      "label": "SF-1",
      "layoutId": "sf1",
      "fields": [
        {
          "id": "skillFactoryName",
          "label": "Skill Factory Name",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": true, "maxLength": 80 },
          "mapping": { "placeholderId": "SF1_SKILL_FACTORY_NAME" }
        },
        {
          "id": "sprintNumber",
          "label": "Sprint Number",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": true, "maxLength": 40 },
          "mapping": { "placeholderId": "SF1_SPRINT_NUMBER" }
        },
        {
          "id": "dateRangeStart",
          "label": "Date Range (Start)",
          "type": "date",
          "defaultValue": "",
          "validation": { "required": true },
          "mapping": { "placeholderId": "SF1_DATE_RANGE" }
        },
        {
          "id": "dateRangeEnd",
          "label": "Date Range (End)",
          "type": "date",
          "defaultValue": "",
          "validation": { "required": true },
          "mapping": { "placeholderId": "SF1_DATE_RANGE" }
        },
        {
          "id": "projectHighlights",
          "label": "Project Highlights",
          "type": "textarea",
          "defaultValue": "",
          "validation": { "required": true, "maxLines": 12 },
          "mapping": { "placeholderId": "SF1_PROJECT_HIGHLIGHTS" }
        },
        {
          "id": "projectLowlights",
          "label": "Project Lowlights",
          "type": "textarea",
          "defaultValue": "",
          "validation": { "required": true, "maxLines": 12 },
          "mapping": { "placeholderId": "SF1_PROJECT_LOWLIGHTS" }
        },
        {
          "id": "teamMembers",
          "label": "Team Members",
          "type": "table",
          "defaultValue": [],
          "validation": { "required": false },
          "table": {
            "columns": [
              { "id": "name", "label": "Name", "type": "string" },
              { "id": "role", "label": "Role", "type": "string" }
            ]
          },
          "mapping": { "placeholderId": "SF1_TEAM_MEMBERS_TABLE" }
        },
        {
          "id": "activitiesCompleted",
          "label": "Key activities completed in previous week",
          "type": "bullets",
          "defaultValue": [],
          "validation": { "required": false },
          "mapping": { "placeholderId": "SF1_KEY_ACTIVITIES_COMPLETED" }
        },
        {
          "id": "activitiesPlanned",
          "label": "Key activities planned for next week",
          "type": "bullets",
          "defaultValue": [],
          "validation": { "required": false },
          "mapping": { "placeholderId": "SF1_KEY_ACTIVITIES_PLANNED" }
        }
      ]
    },
    "sf2": {
      "label": "SF-2",
      "layoutId": "sf2",
      "fields": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": false, "maxLength": 120 },
          "mapping": { "placeholderId": "SF2_HEADING" }
        },
        {
          "id": "body",
          "label": "Body",
          "type": "richText",
          "defaultValue": "",
          "validation": { "required": false, "maxLines": 10 },
          "mapping": { "placeholderId": "SF2_BODY" }
        }
      ]
    },
    "sf3": {
      "label": "SF-3",
      "layoutId": "sf3",
      "fields": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": false, "maxLength": 120 },
          "mapping": { "placeholderId": "SF3_HEADING" }
        },
        {
          "id": "body",
          "label": "Body",
          "type": "richText",
          "defaultValue": "",
          "validation": { "required": false, "maxLines": 10 },
          "mapping": { "placeholderId": "SF3_BODY" }
        }
      ]
    },
    "sf4": {
      "label": "SF-4",
      "layoutId": "sf4",
      "fields": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "string",
          "defaultValue": "",
          "validation": { "required": false, "maxLength": 120 },
          "mapping": { "placeholderId": "SF4_HEADING" }
        },
        {
          "id": "body",
          "label": "Body",
          "type": "richText",
          "defaultValue": "",
          "validation": { "required": false, "maxLines": 10 },
          "mapping": { "placeholderId": "SF4_BODY" }
        }
      ]
    },
    "global_last": {
      "label": "Global Last",
      "layoutId": "global_last",
      "fields": []
    }
  }
}
