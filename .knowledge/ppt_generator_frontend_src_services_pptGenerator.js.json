{"is_source_file": true, "format": "JavaScript", "description": "This file is a JavaScript module that provides functions to generate PowerPoint presentations (PPTX) using the pptxgenjs library. It includes utilities for data URL conversions, applying transformations to data, rendering slide content (images, text, shapes), managing placeholders, and orchestrating the creation of slides based on a template and wizard data. The core function 'generatePptx' constructs a presentation with customized slides, supporting background images, fixed shapes, and dynamic content placement.", "external_files": ["./schemaLoader"], "external_methods": ["buildTemplateIndex", "getLayout", "getTemplatePlaceholder", "resolveTemplateAssetUrl"], "published": ["generatePptx"], "classes": [], "methods": [{"name": "isProbablyDataUrl(v)", "description": "Checks if a string is probably a data URL starting with 'data:'", "scope": "", "scopeKind": ""}, {"name": "fileToDataUrl(file)", "description": "Converts a file or string to a data URL, handling File objects and strings", "scope": "", "scopeKind": ""}, {"name": "urlToDataUrl(url)", "description": "Fetches a resource by URL and converts it to a data URL", "scope": "", "scopeKind": ""}, {"name": "applyTransform(value, transformName)", "description": "Applies specified transformations (bullets to lines, percent formatting, currency formatting) to a value", "scope": "", "scopeKind": ""}, {"name": "resolveDeckTitle(wizardData)", "description": "Determines the deck title based on wizard data, defaulting to 'presentation'", "scope": "", "scopeKind": ""}, {"name": "formatGlobalFirstLabeledLine(fieldId, rawValue)", "description": "Formats 'Name' and 'Date' lines for the 'Global First' slide type, showing placeholders when values are empty", "scope": "", "scopeKind": ""}, {"name": "safeFileName(name)", "description": "Sanitizes a string to be a safe filename, converting to lowercase, replacing spaces with hyphens, and removing unsafe characters", "sco