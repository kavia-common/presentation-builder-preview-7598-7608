{"is_source_file": true, "format": "JavaScript", "description": "This file defines functions for generating PowerPoint presentations using the pptxgenjs library. It handles data URL conversions, applies template-based transformations, manages slide rendering including backgrounds, placeholders, images, and fixed shapes, and exports a main function generatePptx to produce the PPTX Blob and filename based on provided template models, user data, and slide order.", "external_files": ["./schemaLoader", "../utils/dateFormat", "./templateStyle"], "external_methods": ["buildTemplateIndex", "getLayout", "getTemplatePlaceholder", "resolveTemplateAssetUrl", "formatDdMmmYyyy", "formatDateRangeDdMmmYyyy", "buildPptTextOptionsFromTemplateStyle"], "published": ["generatePptx"], "classes": [], "methods": [{"name": "isProbablyDataUrl(v)", "description": "Checks if the given string likely represents a data URL based on its prefix.", "scope": "", "scopeKind": ""}, {"name": "fileToDataUrl(file)", "description": "Converts a File object or string to a data URL asynchronously.", "scope": "", "scopeKind": ""}, {"name": "urlToDataUrl(url)", "description": "Fetches a URL and converts its content to a data URL asynchronously.", "scope": "", "scopeKind": ""}, {"name": "applyTransform(value, transformName)", "description": "Applies specific transformations to input values based on transformation name, e.g., formatting percentages, currency, or converting arrays to bullet lines.", "scope": "", "scopeKind": ""}, {"name": "resolveDeckTitle(wizardData)", "description": "Determines the deck's title based on the wizard data, defaulting to 'presentation'.", "scope": "", "scopeKind": ""}, {"name": "safeFileName(name)", "description": "Sanitizes a string to be a safe filename by removing invalid characters and formatting.", "scope": "", "scopeKind": ""}, {"name": "resolveValueForStep(wizardData, slideStep, fieldId)", "description": "Retrieves a value for a slide step based on its data path scope and identifiers.", "scope": "", "scopeKind": ""}, {"name": "ptToIn(pt)", "description": "Converts points to inches, assuming 72 points per inch.", "scope": "", "scopeKind": ""}, {"name": "addFallbackText(slide, i, value)", "description": "Adds fallback text to a slide at a specified index for rendering when template placement info is missing.", "scope": "", "scopeKind": ""}, {"name": "addFallbackImage(slide, i, fileOrUrl)", "description": "Adds a fallback image to a slide from a file or URL if the specified data is available.", "scope": "", "scopeKind": ""}, {"name": "renderFixedShapes(slide, layout, templateIndex)", "description": "Renders fixed shapes (e.g., rectangles, images) on a slide based on layout definitions.", "scope": "", "scopeKind": ""}, {"name": "generatePptx({ templateModel, extractedTemplate, orderedSlides, wizardData })", "description": "Main exported function that creates a PPTX Blob and filename given template info, slide order, and user data.", "scope": "", "scopeKind": ""}], "calls": ["buildTemplateIndex", "getLayout", "getTemplatePlaceholder", "resolveTemplateAssetUrl", "formatDdMmmYyyy", "formatDateRangeDdMmmYyyy", "buildPptTextOptionsFromTemplateStyle", "fileToDataUrl", "urlToDataUrl", "renderFixedShapes"], "search-terms": ["pptxgenjs", "templateModel", "slideType", "globalFirst", "globalLast", "placeholderId", "background asset", "fixedShapes", "generatePptx"], "state": 2, "file_id": 17, "knowledge_revision": 163, "git_revision": "00f70c59f96ba76342ba055ec3a6b54b6b4440ac", "revision_history": [{"45": "ab646b51f0a1c8ce14536f8b6b5ce424a5765235"}, {"60": "af5f22308b5559c26c6d9e3e8e2c496d073fe3ef"}, {"76": "034b83f53dffb28dc53bae0d905967afce86ff56"}, {"87": "d757eba5560e532a2e024a5a8c0eb900ecb1ab76"}, {"98": "d757eba5560e532a2e024a5a8c0eb900ecb1ab76"}, {"103": "d757eba5560e532a2e024a5a8c0eb900ecb1ab76"}, {"107": "87304fa3169a7f3f194bbaca7ec9ed792cab79de"}, {"110": "a1d877848c4885a3d778da442b74edcc131d29b2"}, {"113": "a4935127324ea44674ad533fd68d64dd95