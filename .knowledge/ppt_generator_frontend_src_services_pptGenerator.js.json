{"is_source_file": true, "format": "JavaScript", "description": "This file defines a JavaScript module for generating PowerPoint presentations using the 'pptxgenjs' library. It includes functions for handling image data URLs, applying transformations to content, rendering slides with placeholders, background images, fixed shapes, and exporting the final PPTX as a Blob. The primary exported function is 'generatePptx', which orchestrates the presentation creation based on template models, slide layouts, wizard data, and slide ordering.", "external_files": ["pptxgenjs", "./schemaLoader"], "external_methods": ["buildTemplateIndex", "getLayout", "getTemplatePlaceholder", "resolveTemplateAssetUrl"], "published": ["generatePptx"], "classes": [], "methods": [{"name": "isProbablyDataUrl(v)", "description": "Checks if a string value is likely a data URL based on its prefix.", "scope": "", "scopeKind": ""}, {"name": "fileToDataUrl(file)", "description": "Converts a File object or a string URL to a data URL, handling various input types.", "scope": "", "scopeKind": ""}, {"name": "urlToDataUrl(url)", "description": "Fetches a URL and converts the response to a data URL, used for images/assets.", "scope": "", "scopeKind": ""}, {"name": "applyTransform(value, transformName)", "description": "Applies a specified transformation (like percent formatting or bullets to lines) to a value.", "scope": "", "scopeKind": ""}, {"name": "resolveDeckTitle(wizardData)", "description": "Determines the presentation deck's title based on global first data or defaults.", "scope": "", "scopeKind": ""}, {"name": "formatGlobalFirstLabeledLine(fieldId, rawValue)", "description": "Formats 'Name' and 'Date' lines with labels and placeholder content for Global First slides.", "scope": "", "scopeKind": ""}, {"name": "safeFileName(name)", "description": "Sanitizes a filename string to be URL/file-system safe, used for the PPTX filename.", "scope": "", "scopeKind": ""}, {"name": "resolveValueForStep(wizardData, slideStep, fieldId)", "description": "Fetches the appropriate value for a slide step based on its data scope and group.", "scope": "", "scopeKind": ""}, {"name": "ptToIn(pt)", "description": "Converts points to inches (used for positioning in pptxgen).", "scope": "", "scopeKind": ""}, {"name": "addFallbackText(slide, i, value)", "description": "Adds placeholder fallback text to a slide if content is missing.", "scope": "", "scopeKind": ""}, {"name": "addFallbackImage(slide, i, fileOrUrl)", "description": "Adds a fallback image to a slide as an inline URL or file.", "scope": "", "scopeKind": ""}, {"name": "renderFixedShapes(slide, layout, templateIndex)", "description": "Renders static, fixed shapes (e.g., rectangles, images) onto a slide, based on layout configuration.", "scope": "", "scopeKind": ""}, {"name": "generatePptx({ templateModel, extractedTemplate, orderedSlides, wizardData })", "description": "Main exported function that creates a PowerPoint presentation Blob using pptxgenjs, custom templates, and wizard data.", "scope": "", "scopeKind": ""}], "calls": ["buildTemplateIndex", "getLayout", "getTemplatePlaceholder", "resolveTemplateAssetUrl", "urlToDataUrl", "fileToDataUrl", "renderFixedShapes", "addFallbackText", "addFallbackImage"], "search-terms": ["pptxgenjs", "schemaLoader", "generatePptx", "slide rendering", "template placeholders", "background images", "fixed shapes", "global first", "global last", "placeholder IDs", "template model", "wizard data"], "state": 2, "file_id": 17, "knowledge_revision": 134, "git_revision": "ff3f800f8bdca094a26c7af3483c46f66e5e3fc4", "revision_history": [{"45": "ab646b51f0a1c8ce14536f8b6b5ce424a5765235"}, {"60": "af5f22308b5559c26c6d9e3e8e2c496d073fe3ef"}, {"76": "034b83f53dffb28dc53bae0d905967afce86ff56"}, {"87": "d757eba5560e532a2e024a5a8c0eb900ecb1ab76"}, {"98": "d757eba5560e532a2e024a5a8c0eb900ecb1ab76"}, {"103": "d757eba5560e532a2e024a5a8c0eb900ecb1ab76"}, {"107": "87304fa3169a7f3f194bbaca7ec9ed792cab79de"}, {"110